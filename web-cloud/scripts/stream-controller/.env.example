# --- AWS IoT ---
AWS_IOT_ENDPOINT=a3c1jrwyyxkjx6-ats.iot.eu-west-3.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_CA=./certs/AmazonRootCA1.pem
AWS_IOT_CERT=./certs/device.pem.crt
AWS_IOT_KEY=./certs/device.private.key
AWS_IOT_CLIENT_ID=stream-controller-lab1

# Topics this controller listens to (comma-separated).
MQTT_TOPICS=ROTARY/Stream,SUSP/Stream

# --- OBS WebSocket (Tools -> WebSocket Server Settings in OBS) ---
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=gradproject_2026

# Auto-stop the stream after this many seconds with no fresh "start"
# message. 0 disables auto-stop.
IDLE_STOP_SECONDS=600
