<Section collapsed="false" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">Figure 1: System Schematic</Font></Text-field></Title>
<Text-field style="Text" layout="Normal" alignment="centred"><Image height="629" width="431" zoomable="false" labelreference="L11" drawcaption="false" captionalignment="0" captionposition="1"><Drawing-Root>LSUlUk9PVEc2Jy0lKUJPVU5EU19YRzYjJCIiISEiIi0lKUJPVU5EU19ZR0YnLSUtQk9VTkRTX1dJRFRIRzYjJCIlNVZGKi0lLkJPVU5EU19IRUlHSFRHNiMkIiUhSCdGKi0lKUNISUxEUkVORzYi</Drawing-Root></Image></Text-field>
</Section>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">The generalized coordinates are also called Lagrangian coordinates.</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> =  the position of mass 1, the ground plane</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> =  the position of mass 1 presenting a tire center of mass measured from is resting position</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Equation executable="false" style="2D Math" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> position of mass 2, representing the car body measured from its resting position</Font></Text-field>
<Text-field style="2D Input" executable="false" layout="Normal"></Text-field>
<Group labelreference="L13" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">q1 := [ x[1](t), x[2](t) ,z[r](t) , x[1](t)-z[r](t), x[2](t)-x[1](t)];</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NyctJkkieEc2IjYjIiIiNiNJInRHRiYtJkYlNiMiIiNGKS0mSSJ6R0YmNiNJInJHRiZGKSwmRiNGKEYvISIiLCZGK0YoRiNGNQ==</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L14" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">q := [ x[1](t), x[2](t)  ];</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NyQtJkkieEc2IjYjIiIiNiNJInRHRiYtJkYlNiMiIiNGKQ==</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L15" drawlabel="true">
<Input>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">Nq = number of Lagrangian coordinates</Font></Text-field>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">Nq is also the number of position states.</Font></Text-field>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">Nq := nops( q ):</Text-field>
</Input>
</Group>
<Group labelreference="L16" drawlabel="true">
<Input>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">qd = first-order time derivative of the generalized coordinates, e.g. position and angular velocities</Font></Text-field>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">qd := map( diff, q, t );</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NyQtSSVkaWZmRyUqcHJvdGVjdGVkRzYkLSZJInhHNiI2IyIiIjYjSSJ0R0YqRi4tRiQ2JC0mRik2IyIiI0YtRi4=</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L17" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">Nq := nops( q ):</Text-field>
</Input>
</Group>
<Group labelreference="L18" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">u := z[r](t);</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LSZJInpHNiI2I0kickdGJTYjSSJ0R0Yl</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L19" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">ud:= diff(u,t);</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LUklZGlmZkclKnByb3RlY3RlZEc2JC0mSSJ6RzYiNiNJInJHRik2I0kidEdGKUYt</Equation></Text-field>
</Output>
</Group>
