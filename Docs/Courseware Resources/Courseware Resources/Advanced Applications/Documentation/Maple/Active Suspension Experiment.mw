<Section collapsed="false" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title>
<Text-field style="2D Input" executable="false" layout="Normal" spacebelow="4" spaceabove="8"><Font executable="false">Euler-Lagrange's Equations</Font></Text-field></Title>
<Text-field style="Normal" layout="Normal"><Font style="2D Input" executable="false">For a </Font><Font style="Text" italic="true">N</Font><Font style="2D Input" executable="false">-DOF system, the Lagrange's equations can be written:</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false">  for </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> through </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation></Text-field>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">where:</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Font style="2D Input" executable="false"> </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false">'s are special combinations of external forces and called the </Font><Font style="Text" italic="true">generalized forces,</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Font style="Text" italic="true"> </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false">, ..., </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false">, are </Font><Font style="Text" italic="true">N </Font><Font style="2D Input" executable="false">independent coordinates chosen to describe the system and called the </Font><Font style="Text" italic="true">generalized coordinates</Font><Font style="2D Input" executable="false">,</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Font style="2D Input" executable="false"> and </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> is the </Font><Font style="Text" italic="true">Lagrangian</Font><Font style="2D Input" executable="false"> of the system.</Font></Text-field>
<Text-field style="Normal" layout="Normal"><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> is defined by:</Font></Text-field>
<Text-field style="2D Comment" layout="Normal"><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation></Text-field>
<Text-field style="Normal" layout="Normal"><Font style="2D Input" executable="false">where </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> is the total kinetic energy of the system and </Font><Equation executable="false" style="2D Comment" input-equation="">LUklbXJvd0c2Iy9JK21vZHVsZW5hbWVHNiJJLFR5cGVzZXR0aW5nR0koX3N5c2xpYkdGJzYlLUkjbWlHRiQ2I1EhRictRiM2I0YrRis=</Equation><Font style="2D Input" executable="false"> the total potential energy of the system.</Font></Text-field>
<Group labelreference="L43" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">EOM_orig := lagrange_equations( T[T], V[T], q, Q );</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L44" drawlabel="true">
<Input>
<Text-field style="2D Input" executable="false" layout="Normal"><Font executable="false">this is to display the EOM's</Font></Text-field>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">EOM_orig := collect( EOM_orig, { seq( diff( q[i], t$2 ), i=1..Nq ), seq( diff( q[i], t ), i=1..Nq ), seq( q[i], i=1..Nq ) } );</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L45" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">EOM_New := collect( EOM_orig,{seq( diff( q[i], t$2 ), i=1..Nq ), seq( diff( q[i], t ), i=1..Nq ), K[s],K[us]},distributed,factor);</Text-field>
</Input>
<Output>
